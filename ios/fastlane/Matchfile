# Distribution cert + app-store profile live encrypted in a private certs repo,
# so every CI run reuses one cert. Without this, each ephemeral runner mints a
# new Apple Distribution certificate and the team hits Apple's cap after a few
# builds.
git_url(ENV.fetch("MATCH_GIT_URL", "https://github.com/Plynth-Labs/efi-certs.git"))
storage_mode("git")
type("appstore")
app_identifier(["com.plynth.efi"])
